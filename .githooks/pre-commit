#!/usr/bin/env bash
set -euo pipefail

GLOBAL_HOOKS="$HOME/.config/git/ai-commit-hooks/pre-commit"

if [ -x "$GLOBAL_HOOKS" ]; then
    . "$GLOBAL_HOOKS"
fi

echo "⟳ cargo fmt --check ..."
cargo fmt --check
echo "✓ cargo fmt --check passed"

# Only run clippy when Rust source files are staged
if git diff --cached --name-only --diff-filter=ACM -- '*.rs' | head -1 | grep -q .; then
    echo "➳ cargo clippy (--workspace --all-targets) ..."
    cargo clippy --workspace --all-targets -- -D warnings
    echo "✓ cargo clippy passed"
else
    echo "✓ cargo clippy (skipped — no .rs files staged)"
fi

# Run the full test suite (lib + integration) when Rust source files are staged —
# matches what CI runs. The integration tests (e.g. ithmb-cli/tests/cli.rs) have
# caught real regressions (version_flag) that --lib alone misses.
if git diff --cached --name-only --diff-filter=ACM -- '*.rs' | head -1 | grep -q .; then
    echo "➳ cargo test --workspace --tests ..."
    cargo test --workspace --tests 2>/dev/null
    echo "✓ cargo test passed"
else
    echo "✓ cargo test (skipped — no .rs files staged)"
fi
