# Whitelist convention: block everything by default, unblock specific paths.
# Prevents accidentally tracking stray files (build artifacts, IDE files, temp files).
/*
!/.gitignore
!/.gitattributes
!.editorconfig
!/LICENSE
!/rust-toolchain.toml
!/Cargo.toml
!/Cargo.lock
!/mise.toml
!/deny.toml
!/*.md
!/.github/
!/.github/**
!/.githooks/
!/.githooks/**
!/docs/
!/docs/**
!/fuzz/
!/fuzz/**
!/scripts/
!/scripts/**
!/tools/
!/tools/**
!/crates/
!/crates/**
pymod/.venv/
pymod/__pycache__/

!/ithmb-core/
!/ithmb-core/**
!/pymod/
!/pymod/**
!/samples/
!/samples/**

# Whitelist exceptions — re-exclude specific paths within whitelisted areas
target/
.omo/
mcp/
.ruff_cache/
*.bak

# Secrets — never commit environment files
.env
.env.*

# Core dumps (Linux: core.<pid>)
core.[0-9]*
*.core

!typos.toml
TECH_DEBT_AUDIT.md
